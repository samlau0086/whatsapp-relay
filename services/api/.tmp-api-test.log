                                      }
                                    >
                                      <RefreshCw
                                        className={
                                          retryingMessageId === message.id
                                            ? "spin"
                                            : ""
                                        }
                                        size={13}
                                      />
                                      <span>
                                        {retryingMessageId === message.id
                                          ? "重新发送中…"
                                          : "重新发送"}
                                      </span>
                                    </button>
                                  </div>
                                )}
                            </div>
                          </article>
                        ))
                      ) : (
                        <EmptyState
