          setError("每个商品需要选择不同的产品图片");
          setImagePickerProductId(null);
          return;
        }
        updateProduct(imagePickerProductId, { imageMediaId: asset.id, imageUrl: null, imageName: asset.fileName });
        setError("");
        setImagePickerProductId(null);
