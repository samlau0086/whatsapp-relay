                      onUseDraft={setDraft}
                      onSent={() => void loadMessages(apiToken, active.id)}
                    />}
                    {active.accountStatus !== "online" && (
                      <div className="offline-banner">
                        <WifiOff size={15} />
                        <span>该账号当前离线；发送请求仍会进入持久队列。</span>
