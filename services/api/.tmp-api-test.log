      async function submit() {
        const money = /^\d+(?:\.\d{1,2})?$/,positiveNumber=/^\d+(?:\.\d+)?$/;
        if(!currency){setError("请先在设置中配置基准货币");return;}
        if(paymentProfiles.length&&!paymentProfileId){setError("请选择付款方式与 Profile");return;}
        if (
          products.some(
            (item) =>
              !item.name.trim() ||
