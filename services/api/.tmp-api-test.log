          if(!result.response.ok||!body.data){setMessageTranslations(all=>({...all,...Object.fromEntries(chunk.map(id=>[id,{status:"failed" as const,sourceLanguage,targetLanguage,message:body.message??"翻译服务暂时不可用"}]))}));continue;}
