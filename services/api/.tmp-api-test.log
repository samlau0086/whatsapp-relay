      function updateProduct(id: string, change: Partial<DraftProduct>) {
        setProducts((all) =>
          all.map((item) => (item.id === id ? { ...item, ...change } : item)),
        );
      }
      function updateFee(id: string, change: Partial<DraftFee>) {
