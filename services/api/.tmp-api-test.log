                            onOpenChange={handleQuickReplyOpen}
                            onAdd={() => {
                              setQuickReplyOpen(false);
                              setQuickReplyEditor(null);
                            }}
                            onEdit={(item) => {
                              setQuickReplyOpen(false);
                              setQuickReplyEditor(item);
                            }}
                            onDelete={deleteQuickReply}
