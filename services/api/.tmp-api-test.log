                                        sourceLanguage,
                                        true,
                                      )
                                    }
                                  />
                                )}{" "}
                              {message.attachment && (
                                <MessageMedia
                                  attachment={message.attachment}
                                  token={apiToken}
                                  onToken={setApiToken}
                                  onReady={keepMessagesAtEnd}
                                  onPreview={() => setImageViewerMessageId(message.id)}
                                />
                              )}{" "}
                              {(translationPreference.enabled ||
