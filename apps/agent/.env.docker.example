RELAY_CENTRAL_URL=https://relay.example.com
RELAY_ENROLLMENT_CODE=replace-with-15-minute-enrollment-code
RELAY_AGENT_NAME=VPS WhatsApp Agent
RELAY_ACCOUNT_ID=replace-with-a-new-uuid
RELAY_ACCOUNT_NAME=Sales WhatsApp
# Generate once with: openssl rand -hex 32
RELAY_MASTER_KEY=
# Optional HTTP/HTTPS proxy, for example: http://host.docker.internal:7897
RELAY_PROXY_URL=
# The host port is bound to 127.0.0.1 by default; access with an SSH tunnel.
RELAY_UI_BIND=127.0.0.1
RELAY_UI_PORT=8788
